# UtsavOps AI - Environment Configuration
# Copy this file to .env or .env.local:
# cp .env.example .env

# OpenRouter API Key (Optional - default key is pre-configured out of the box)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Provider API Keys (Can also be configured directly in the browser via the BYOK Settings modal)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
